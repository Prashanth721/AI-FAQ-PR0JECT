{
  "info": {
    "name": "AI FAQ Assistant API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Priya Sharma\",\n  \"email\": \"priya@example.com\",\n  \"password\": \"securepass123\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/register"
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"priya@example.com\",\n  \"password\": \"securepass123\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "Create FAQ",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"What are your support hours?\",\n  \"answer\": \"9 AM to 6 PM, Mon-Fri.\",\n  \"category\": \"Support\"\n}"
        },
        "url": "{{baseUrl}}/api/faqs"
      }
    },
    {
      "name": "List FAQs",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/faqs"
      }
    },
    {
      "name": "Search FAQs",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/faqs/search?q=support"
      }
    },
    {
      "name": "Generate FAQ (Gemini)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"topic\": \"how to reset a forgotten password\"\n}"
        },
        "url": "{{baseUrl}}/api/ai/generate-faq"
      }
    },
    {
      "name": "Ask Assistant",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"when is support available?\"\n}"
        },
        "url": "{{baseUrl}}/api/ai/ask"
      }
    }
  ]
}
